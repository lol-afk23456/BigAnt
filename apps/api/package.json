{
  "name": "@bigant/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts src/worker.ts --bundle --platform=node --format=esm --outdir=dist --external:fastify --external:@fastify/* --external:@prisma/client --external:argon2 --external:jose --external:dotenv --external:zod --external:sharp --external:web-push",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@bigant/core": "workspace:*",
    "@bigant/database": "workspace:*",
    "@bigant/i18n": "workspace:*",
    "@bigant/types": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "6.19.2",
    "argon2": "^0.44.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "jose": "^6.1.3",
    "sharp": "0.34.5",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2"
  }
}
