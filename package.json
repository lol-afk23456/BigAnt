{
  "name": "bigant-book",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "turbo dev",
    "generate": "pnpm --filter @bigant/database generate",
    "typecheck": "pnpm generate && NEXT_TELEMETRY_DISABLED=1 TURBO_TELEMETRY_DISABLED=1 turbo typecheck --concurrency=2 && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm generate && NEXT_TELEMETRY_DISABLED=1 TURBO_TELEMETRY_DISABLED=1 turbo build --concurrency=2 && node scripts/build-state.mjs --record",
    "seed": "tsx packages/database/src/seed.ts",
    "db:migrate": "pnpm --filter @bigant/database migrate",
    "db:local": "node scripts/local-db.mjs",
    "local": "node scripts/local.mjs",
    "demo:reset": "tsx packages/database/src/reset-demo.ts",
    "worker:once": "tsx apps/api/src/worker.ts",
    "worker:watch": "tsx apps/api/src/worker.ts --watch",
    "test:menu-performance": "node scripts/menu-performance.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.2",
    "@prisma/client": "6.19.2",
    "@types/node": "^22.19.0",
    "dotenv": "^17.3.1",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9.39.0",
    "lighthouse": "^13.4.1",
    "tsx": "^4.21.0",
    "turbo": "^2.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
