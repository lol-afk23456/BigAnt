DATABASE_URL=postgresql://bigant:bigant_local@127.0.0.1:55432/bigant?schema=public
JWT_SECRET=replace-with-at-least-32-random-bytes
PORT=3001
HOST=127.0.0.1
# Rewrite web: impostare alla build, destinazione API interna del proprio ambiente.
API_INTERNAL_URL=http://127.0.0.1:3001
TEST_DATABASE_URL=postgresql://bigant:bigant_local@127.0.0.1:55432/bigant_test?schema=public
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1

# Foto menu locali: percorso assoluto opzionale; default .local/menu-images
# MENU_IMAGE_DIR=/percorso/BigAnt/.local/menu-images

# M5: la modalità demo NON spedisce messaggi. Non inserire segreti nel repository.
NOTIFICATION_MODE=demo
PUBLIC_ORIGIN=http://localhost:3000
# Modalità live: HTTPS, verifica dei fornitori e credenziali necessarie.
DELIVERY_EU_VERIFIED=false
TEM_SECRET_KEY=
TEM_PROJECT_ID=
EMAIL_FROM=
# SMS: adattatore candidato Twilio IE1, attivazione sospesa fino alla verifica EU.
SMS_EU_VERIFIED=false
SMS_ACCOUNT_ID=
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM=
# Push: filiera del browser da verificare, chiavi VAPID da conservare come segreti.
PUSH_EU_VERIFIED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
