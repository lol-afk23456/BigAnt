{
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "JWT_SECRET",
        "NEXT_TELEMETRY_DISABLED",
        "API_INTERNAL_URL"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@bigant/core#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@bigant/database#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@bigant/i18n#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@bigant/types#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@bigant/ui#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "NEXT_TELEMETRY_DISABLED",
    "TURBO_TELEMETRY_DISABLED"
  ]
}
